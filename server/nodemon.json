{
    "watch": [
        "server.js",
        "routes",
        "models",
        "config",
        "middleware"
    ],
    "ext": "js,json",
    "ignore": [
        "node_modules",
        "*.test.js"
    ],
    "delay": "1000",
    "env": {
        "NODE_ENV": "development"
    },
    "verbose": true,
    "restartable": "rs",
    "events": {
        "restart": "echo '🔄 Server restarting due to file changes...'"
    }
}